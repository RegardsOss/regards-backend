    + String originUrl
    + String storageSubDirectory
    + String storage
    + FileReferenceMetaInfo metaInfo
    + FileRequestStatus status
    + OffsetDateTime creationDate
    + String errorCause
    + String jobId
    + String session
}

class FileStorageRequestAggregation <<Entity>> {
    + Long id
    + Set<String> groupIds
    + Set<String> owners
    + String originUrl
    + String storageSubDirectory
    + String storage
    + FileReferenceMetaInfo metaInfo
    + FileRequestStatus status
    + OffsetDateTime creationDate
    + String errorCause
    + String jobId
    + String session
}
class FileReferenceMetaInfo <<Embeddable>> {
    + String fileName
    + String checksum
    + String algorithm
    + String mimeType
    + String type

    + Long fileSize
    + Integer height
    + Integer width
}

FileReferenceRequestAggregation -right-> FileReferenceMetaInfo
FileStorageRequestAggregation -left-> FileReferenceMetaInfo

class FileReference <<Entity>> {
+ Long id
+ OffsetDateTime storageDate

+ Set<String> owners
+ FileReferenceMetaInfo metaInfo
+ FileLocation location

+ boolean referenced
+ boolean nearlineConfirmed
}
FileReference -up-> FileReferenceMetaInfo
FileReference -right-> FileLocation

class FileLocation <<Embeddable>> {
+ String storage
+ String url
+ boolean  pendingActionRemaining
}
}
