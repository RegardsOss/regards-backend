@startuml
'https://plantuml.com/class-diagram

package "file-catalog-amqp / file-access-dto"  {
    class FileReferenceRequestDto <<DTO>> {
        + String fileName
        + String checksum
        + String algorithm
        + String mimeType
        + String type

        + Long fileSize
        + Integer height
        + Integer width

        + String owner
        + String storage
        + String url
        + String sessionOwner
        + String session
    }

    class FilesReferenceDto <<DTO>> {
        + String groupId
        + Set<FileReferenceRequestDto> files
    }

    class FilesReferenceEvent  <<Event>> {
        + Errors validate(Validator validator)
    }
    FilesReferenceEvent --|>FilesReferenceDto
    FilesReferenceDto *..> FileReferenceRequestDto

    class FileStorageRequestDto <<DTO>> {
             + String fileName
             + String checksum
             + String algorithm
             + String mimeType
             + String type

            + String owner
            + String storage
            + String originUrl
            + String sessionOwner
            + String session

            + boolean reference
    }

    class FilesStorageRequestDto <<DTO>> {
        + String groupId
        + Set<FileStorageRequestDto> files
    }

    class FilesStorageRequestEvent <<Event>>
    FilesStorageRequestEvent --|>FilesStorageRequestDto
    FilesStorageRequestDto *..> FileStorageRequestDto


    class FileReferenceEvent <<Event>> {
        + FileReferenceEventType type
        + String message
    }

    class FileReferenceDto <<DTO>> {
         + Long id

         + List<String> owners
         + Set<String> groupIds

         + String originStorage
         + String checksum

         + FileLocationDto location
         + FileReferenceMetaInfoDto metaInfo
         + OffsetDateTime storageDate

         + Object additionalFields

         + boolean referenced
         + boolean nearlineConfirmed
    }

    class FileLocationDto <<DTO>> {
        + String storage
        + String url
        + FileArchiveStatus fileArchiveStatus
    }
    FileReferenceDto .right.> FileLocationDto

    class FileReferenceMetaInfoDto <<DTO>> {
         + String fileName
         + String checksum
         + String algorithm
         + String mimeType
         + String type

         + Long fileSize
         + Integer height
         + Integer width
    }
    FileReferenceEvent --|>FileReferenceDto
    FileReferenceDto ..> FileReferenceMetaInfoDto

    class FileStorageRequestAggregationDto {

        + Long id

        + Set<String> owners
        + Set<String> groupIds

        + String storage;
        + String originUrl

        + String subDirectory

        + OffsetDateTime creationDate;
        + FileReferenceMetaInfoDto metaInfo;

        + String sessionOwner
        + String session
        + String jobId;
        + String errorCause;
    }
    FileStorageRequestAggregationDto ..> FileReferenceMetaInfoDto

}
@enduml

