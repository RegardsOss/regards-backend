}
class StorageLocation <<Entity>> {
    + Long id
    + String name
    + Long numberOfReferencedFiles
    + Long totalSizeOfReferencedFiles
    + OffsetDateTime lastUpdateDate
    + boolean pendingActionRemaining
}

class FileReferenceMetaInfo <<Embeddable>> {
    + String fileName
    + String checksum
    + String algorithm
    + String mimeType
    + String type

    + Long fileSize
    + Integer height
    + Integer width
}
